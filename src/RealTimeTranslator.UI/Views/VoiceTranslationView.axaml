<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RealTimeTranslator.UI.ViewModels"
             xmlns:models="using:RealTimeTranslator.Core.Models"
             xmlns:converters="using:RealTimeTranslator.UI.Converters"
             x:Class="RealTimeTranslator.UI.Views.VoiceTranslationView"
             x:DataType="vm:VoiceTranslationViewModel">
    <UserControl.Resources>
        <converters:LevelMeterMaskWidthConverter x:Key="VoiceLevelMaskWidthConverter"/>
        <LinearGradientBrush x:Key="VoiceLevelGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0.0" Color="#2ECC40"/>
            <GradientStop Offset="0.65" Color="#2ECC40"/>
            <GradientStop Offset="0.80" Color="#FFDC00"/>
            <GradientStop Offset="0.90" Color="#FF851B"/>
            <GradientStop Offset="1.0" Color="#FF4136"/>
        </LinearGradientBrush>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
        </Style>
        <Style Selector="Ellipse.status-dot.running">
            <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
        </Style>
        <Style Selector="Ellipse.status-dot.faulted">
            <Setter Property="Fill" Value="{DynamicResource Brush.Error}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- メイン画面と同じ共通の見出し・ステータス枠・ボタンを使用する。 -->
        <StackPanel Grid.Row="0">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="ボイス通訳" FontSize="20" FontWeight="Bold"/>
                <TextBlock Classes="hint" Margin="0,4,0,0"
                           Text="マイク音声を翻訳し、ゲームのボイスチャットへ送信します"/>
            </StackPanel>
            <HeaderedContentControl Header="ステータス" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="VoiceStatusCard">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button Content="開始" Command="{Binding StartCommand}" Width="140"
                                AutomationProperties.AutomationId="VoiceStart"/>
                        <Button Content="停止" Command="{Binding StopCommand}" Width="140" Margin="8,0,0,0"
                                AutomationProperties.AutomationId="VoiceStop"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Classes="status-dot" Classes.running="{Binding IsRunning}"
                                 Classes.faulted="{Binding IsFaulted}" Width="10" Height="10"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="14" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="VoiceStatus"/>
                    </StackPanel>
                    <TextBlock Text="送信モード" FontSize="12" Foreground="{DynamicResource Brush.FG2}"
                               Margin="0,12,0,6"/>
                    <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}"
                              IsEnabled="{Binding CanChangeMode}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="送信モード"
                              AutomationProperties.AutomationId="VoiceMode">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:VoiceModeOption">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ScrollViewer IsVisible="{Binding HasError}" Margin="0,8,0,0" MaxHeight="96"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.AutomationId="VoiceErrorPanel">
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Brush.Error}"
                                   AutomationProperties.AutomationId="VoiceError"/>
                    </ScrollViewer>
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="VoiceSettingsScroll">
            <StackPanel Margin="0,0,0,16">
                <HeaderedContentControl Header="Wave Link 3 の初回設定"
                                        IsVisible="{Binding NeedsWaveLinkSetup}"
                                        AutomationProperties.AutomationId="VoiceWaveLinkSetupCard">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="hint" Text="ボイス通訳用の仮想オーディオ機器がまだ見つかりません。Wave Link 3 は Windows 11 向けです。字幕翻訳だけなら導入は不要です。"/>
                        <WrapPanel>
                            <Button Content="公式からダウンロード" Command="{Binding DownloadWaveLinkCommand}"
                                    Margin="0,0,8,8" AutomationProperties.AutomationId="VoiceWaveLinkDownload"/>
                            <Button Content="公式の説明" Command="{Binding OpenWaveLinkWebsiteCommand}"
                                    Margin="0,0,0,8" AutomationProperties.AutomationId="VoiceWaveLinkWebsite"/>
                        </WrapPanel>
                        <TextBlock Classes="hint" Text="1. 公式ダウンロードで Wave Link 3 を選び、本体と Audio Driver を導入します。権限の確認や再起動を求められた場合は、インストーラーの案内に従ってください。"/>
                        <TextBlock Classes="hint" Text="2. Wave Link で翻訳音声専用の仮想入力チャンネル（例: Aux 1）を用意します。"/>
                        <TextBlock Classes="hint" Text="3. ゲームへ送る Chat Mix には翻訳専用チャンネルだけを含め、物理マイク・ゲーム音・ほかの音声を外します。"/>
                        <TextBlock Classes="hint" Text="4. 機器を再確認し、このアプリの送信先にその Wave Link 再生チャンネル、ゲームのマイク入力に Chat Mix (Elgato Virtual Audio) を選びます。"/>
                        <Button Content="インストール後に再確認" Command="{Binding RefreshDevicesCommand}"
                                HorizontalAlignment="Left" AutomationProperties.AutomationId="VoiceWaveLinkRecheck"/>
                    </StackPanel>
                </HeaderedContentControl>
                <HeaderedContentControl Header="音声の接続">
                    <StackPanel Spacing="10">
                        <TextBlock Text="入力マイク"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                      IsEnabled="{Binding CanEditSettings}" HorizontalAlignment="Stretch"
                                      PlaceholderText="マイクを選択" AutomationProperties.Name="入力マイク"
                                      AutomationProperties.AutomationId="VoiceMicrophone">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:VoiceAudioDevice">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="更新" Margin="8,0,0,0"
                                    Command="{Binding RefreshDevicesCommand}"
                                    ToolTip.Tip="接続したマイクと Wave Link 3 の機器一覧を更新"
                                    AutomationProperties.Name="機器一覧を更新"
                                    AutomationProperties.AutomationId="VoiceRefreshDevices"/>
                        </Grid>
                        <StackPanel Spacing="6" IsEnabled="{Binding CanEditSettings}">
                            <TextBlock Text="送信先（Wave Link の翻訳専用チャンネル）"/>
                            <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                                      HorizontalAlignment="Stretch" PlaceholderText="Wave Link の再生チャンネルを選択"
                                      AutomationProperties.Name="送信先"
                                      AutomationProperties.AutomationId="VoiceOutput">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:VoiceAudioDevice">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="hint" Text="ゲームのマイク入力には Chat Mix (Elgato Virtual Audio) を選択します。以前の送信先設定は自動変換されないため、Wave Link のチャンネルを選び直してください。"/>
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{Binding DeviceStatus}"
                                   AutomationProperties.AutomationId="VoiceDeviceStatus"/>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="マイクの発話検出（VAD）">
                    <StackPanel Spacing="10">
                        <CheckBox Content="翻訳モードでマイクの発話を検出する"
                                  IsChecked="{Binding EnableVad, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}"
                                  AutomationProperties.Name="翻訳モードのマイク発話検出を有効にする"
                                  AutomationProperties.AutomationId="VoiceVadEnabled"/>
                        <StackPanel Spacing="6" IsEnabled="{Binding CanEditVadSettings}">
                            <TextBlock Text="検出閾値"/>
                            <ComboBox ItemsSource="{Binding VadThresholdOptions}"
                                      SelectedItem="{Binding SelectedVadThreshold, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="マイクの発話検出閾値"
                                      AutomationProperties.AutomationId="VoiceVadThreshold">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VadThresholdOption">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="発話冒頭の保持時間" Margin="0,4,0,0"/>
                            <ComboBox ItemsSource="{Binding VadPreRollOptions}"
                                      SelectedItem="{Binding SelectedVadPreRoll, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="マイクの発話冒頭の保持時間"
                                      AutomationProperties.AutomationId="VoiceVadPreRoll">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VadDurationOption">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="発話末尾の保持時間" Margin="0,4,0,0"/>
                            <ComboBox ItemsSource="{Binding VadHangoverOptions}"
                                      SelectedItem="{Binding SelectedVadHangover, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="マイクの発話末尾の保持時間"
                                      AutomationProperties.AutomationId="VoiceVadHangover">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VadDurationOption">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Classes="hint" Text="閾値を上げるほど小さな音を検出しにくくなります。冒頭・末尾の保持時間は、それぞれ発話の前後を残す長さです。字幕とは別に保存され、次の開始から適用されます。原音送信には適用されません。"/>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="翻訳と送信">
                    <StackPanel Spacing="10" IsEnabled="{Binding CanEditSettings}">
                        <TextBlock Text="相手へ送る言語"/>
                        <ComboBox ItemsSource="{Binding OutputLanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="相手へ送る言語"
                                  AutomationProperties.AutomationId="VoiceLanguage">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OutputLanguageOption">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="hint" Text="API設定の OpenAI API キーを使用します。字幕側とは別の言語を選べます。"/>
                        <StackPanel Spacing="6">
                            <CheckBox Content="押している間だけ送信" IsChecked="{Binding PushToTalkEnabled}"
                                      VerticalAlignment="Center" AutomationProperties.Name="押している間だけ送信（PTT）"
                                      AutomationProperties.AutomationId="VoicePttEnabled"/>
                            <Button Content="{Binding PttCaptureButtonText}" IsEnabled="{Binding CanCapturePttKey}"
                                    Click="BeginCapture" LostFocus="OnCaptureLostFocus" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="発話キーを登録" AutomationProperties.AutomationId="VoicePttKey"/>
                        </StackPanel>
                        <TextBlock Classes="hint" Text="キーのボタンを押して、登録したいキーや Ctrl・Shift・Alt・Win との組み合わせを押し、離してください。Esc でキャンセルします。「押している間だけ送信」をオフにすると、発話キーを使いません。翻訳モードではマイクの発話検出設定に従います。"/>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="訳音声の試聴" AutomationProperties.AutomationId="VoiceMonitorCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="試聴するヘッドホン・スピーカー"/>
                        <ComboBox ItemsSource="{Binding MonitorOutputs}" SelectedItem="{Binding SelectedMonitorOutput}"
                                  IsEnabled="{Binding CanEditMonitorOutput}" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="試聴先" AutomationProperties.AutomationId="VoiceMonitorOutput">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:VoiceAudioDevice">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{Binding MonitorButtonText}" Command="{Binding ToggleMonitoringCommand}"
                                AutomationProperties.AutomationId="VoiceMonitorToggle"/>
                        <TextBlock Classes="hint" Text="{Binding MonitorStatusText}" AutomationProperties.AutomationId="VoiceMonitorStatus"/>
                        <TextBlock Classes="hint" Text="「翻訳音声を送信」で開始したあとに試聴できます。ヘッドホンを推奨します。スピーカーの音がマイクに戻らないようにしてください。"/>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="音量と訳文" AutomationProperties.AutomationId="VoiceGainCard">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="マイク入力ゲイン"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Border Height="14" CornerRadius="3" ClipToBounds="True" Background="{StaticResource VoiceLevelGradient}"
                                        AutomationProperties.Name="マイク入力レベル（ゲイン適用後）" AutomationProperties.AutomationId="VoiceInputLevel">
                                    <Border HorizontalAlignment="Right" Background="#D00F1419">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource VoiceLevelMaskWidthConverter}">
                                                <Binding Path="InputLevelNorm"/>
                                                <Binding Path="Bounds.Width" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                                <Border Grid.Column="1" Width="10" Height="14" CornerRadius="2" Margin="4,0,0,0" Background="#33FF4136"
                                        ToolTip.Tip="入力クリップ。音が潰れる場合は入力ゲインを下げてください。">
                                    <Border Background="#FF4136" CornerRadius="2" IsVisible="{Binding IsInputClipping}"
                                            AutomationProperties.AutomationId="VoiceInputClipping"/>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="hint" Text="レベル（ゲイン適用後）"/>
                                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding InputLevelText}" AutomationProperties.AutomationId="VoiceInputLevelText"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Minimum="-24" Maximum="24" Value="{Binding InputGainDb, Mode=TwoWay}"
                                        TickFrequency="6" TickPlacement="BottomRight" VerticalAlignment="Center"
                                        AutomationProperties.Name="ボイス通訳の入力ゲイン" AutomationProperties.AutomationId="VoiceInputGain"/>
                                <Button Grid.Column="1" Content="0 dB" Command="{Binding ResetInputGainCommand}" Margin="8,0,0,0"
                                        AutomationProperties.Name="マイク入力ゲインを 0 dB に戻す"
                                        AutomationProperties.AutomationId="VoiceResetInputGain"/>
                            </Grid>
                            <TextBlock Text="{Binding InputGainDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="送信・試聴の出力ゲイン"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Border Height="14" CornerRadius="3" ClipToBounds="True" Background="{StaticResource VoiceLevelGradient}"
                                        AutomationProperties.Name="送信音声レベル（ゲイン適用後）" AutomationProperties.AutomationId="VoiceOutputLevel">
                                    <Border HorizontalAlignment="Right" Background="#D00F1419">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource VoiceLevelMaskWidthConverter}">
                                                <Binding Path="OutputLevelNorm"/>
                                                <Binding Path="Bounds.Width" RelativeSource="{RelativeSource AncestorType=Border}"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                                <Border Grid.Column="1" Width="10" Height="14" CornerRadius="2" Margin="4,0,0,0" Background="#33FF4136"
                                        ToolTip.Tip="出力クリップ。音が潰れる場合は出力ゲインを下げてください。">
                                    <Border Background="#FF4136" CornerRadius="2" IsVisible="{Binding IsOutputClipping}"
                                            AutomationProperties.AutomationId="VoiceOutputClipping"/>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="hint" Text="レベル（ゲイン適用後）"/>
                                <TextBlock Grid.Column="1" Classes="hint" Text="{Binding OutputLevelText}" AutomationProperties.AutomationId="VoiceOutputLevelText"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider Minimum="-24" Maximum="24" Value="{Binding OutputGainDb, Mode=TwoWay}"
                                        TickFrequency="6" TickPlacement="BottomRight" VerticalAlignment="Center"
                                        AutomationProperties.Name="ボイス通訳の出力ゲイン" AutomationProperties.AutomationId="VoiceOutputGain"/>
                                <Button Grid.Column="1" Content="0 dB" Command="{Binding ResetOutputGainCommand}" Margin="8,0,0,0"
                                        AutomationProperties.Name="送信・試聴の出力ゲインを 0 dB に戻す"
                                        AutomationProperties.AutomationId="VoiceResetOutputGain"/>
                            </Grid>
                            <TextBlock Text="{Binding OutputGainDb, StringFormat='{}{0:+0.0;-0.0;0.0} dB'}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="hint" Text="左へ動かすと小さく、右へ動かすと大きくなります（-24〜+24 dB）。開始後にメーターを確認し、赤いクリップ表示が点いたら下げてください。出力ゲインは Wave Link と試聴に共通で、原音モードにも適用します。"/>
                        <TextBox Text="{Binding Transcript, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="100" MaxHeight="180"
                                 PlaceholderText="通訳を開始すると、翻訳されたテキストが表示されます"
                                 AutomationProperties.Name="翻訳テキスト"
                                 AutomationProperties.AutomationId="VoiceTranscript"/>
                        <TextBlock Classes="hint" Text="字幕翻訳は「メイン」タブから同時に使用できます。"/>
                    </StackPanel>
                </HeaderedContentControl>

                <Expander Header="ゲーム側の設定・導入手順" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="VoiceSetupGuide">
                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <TextBlock Classes="hint" Text="1. Wave Link 3 本体と Audio Driver を導入し、翻訳音声専用の仮想入力チャンネル（例: Aux 1）を用意します。このアプリの送信先に、その再生チャンネルを選択してください。"/>
                        <TextBlock Classes="hint" Text="2. Wave Link の Chat Mix に翻訳専用チャンネルだけを含め、物理マイク・ゲーム音・ほかの音声を外します。ゲームのボイスチャット入力には Chat Mix (Elgato Virtual Audio) を選びます。"/>
                        <TextBlock Classes="hint" Text="3. ゲーム側は音声検出またはオープンマイクにします。PTT を離したあとに届く翻訳音声も相手へ送るためです。"/>
                        <TextBlock Classes="hint" Text="このアプリ → Wave Link の翻訳専用チャンネル → Chat Mix → ゲームの順に送ります。字幕翻訳は別経路で同時に使用できます。"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
